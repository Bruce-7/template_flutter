# update_fastlane

require 'json'
default_platform(:ios)

platform :ios do
  # 时间格式
  def formatted_time
    Time.now.strftime("%Y-%m-%d-%H:%M:%S")
  end

#   # 发送飞书通知
#   def notify_feishu(title:, version:, build:, type:, content_url:)
#     content_text = "Version：#{version}\nBuild：#{build}\n打包类型：#{type}\n#{content_url}\n"

#     json = {
